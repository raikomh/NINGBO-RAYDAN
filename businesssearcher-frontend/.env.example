# URL base del backend .NET (sin barra final), p. ej. https://mi-backend.onrender.com
# Si se deja vacía, las llamadas /api son relativas al mismo dominio (solo útil con proxy).
VITE_API_URL=

# true = usa el mock de API integrado (sin backend real). Útil para demo del MVP.
VITE_MOCK=false

# Groq API key (gratis en https://console.groq.com) para el widget de chat con IA.
# OJO: al ser variable VITE_ queda incrustada en el bundle público del frontend.
VITE_GROQ_API_KEY=

# Email que se trata como administrador en el frontend
VITE_ADMIN_EMAIL=admin@businesssearcher.dev
